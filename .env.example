# Public application URL. Production: https://ai.pozitifsoftware.com
APP_URL=http://localhost:3000
NODE_ENV=development

# Never reuse these example values in production.
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/navori_publisher
AUTH_SECRET=generate-at-least-32-random-characters

# OpenAI receives instruction text and safe file metadata only; video bytes are never sent.
OPENAI_API_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# Keep false until the tenant-specific contract is verified.
NAVORI_API_ENABLED=false
NAVORI_BASE_URL=https://tenant.example.com/NavoriService/Api/
NAVORI_USERNAME=
NAVORI_PASSWORD=
NAVORI_ALLOWED_HOSTS=tenant.example.com

TEMP_UPLOAD_PATH=./data/uploads
MAX_UPLOAD_SIZE_MB=512
UPLOAD_RETENTION_HOURS=24
LOG_LEVEL=info
